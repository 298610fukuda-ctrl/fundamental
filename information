let answeredSet = new Set();
let rightCount = 0;

function renderQuiz() {
  const container = document.getElementById('quiz-list');
  container.innerHTML = '';

  examData.forEach(q => {
    const card = document.createElement('div');
    card.className = 'q-box';
    card.id = `q-card-${q.id}`;

    let optsHtml = '';
    q.options.forEach(opt => {
      optsHtml += `
        <button class="opt-item" onclick="onSelect(${q.id}, '${opt.key}')" id="opt-${q.id}-${opt.key}">
          <span class="opt-tag">${opt.key}</span>
          <span>${opt.text}</span>
        </button>
      `;
    });

    card.innerHTML = `
      <div class="q-top">
        <span class="q-num">第 ${q.id} 問</span>
        <span class="q-origin">${q.source}</span>
      </div>
      <div class="q-body">${q.body}</div>
      <div class="opt-list" id="opts-${q.id}">
        ${optsHtml}
      </div>
      <div class="exp-section" id="exp-${q.id}"></div>
    `;
    container.appendChild(card);
  });
}

function onSelect(qid, pickedKey) {
  if (answeredSet.has(qid)) return;
  answeredSet.add(qid);

  const q = examData.find(item => item.id === qid);
  const isRight = (pickedKey === q.ans);
  if (isRight) rightCount++;

  document.getElementById('done-count').innerText = answeredSet.size;
  document.getElementById('right-count').innerText = rightCount;

  q.options.forEach(opt => {
    const el = document.getElementById(`opt-${qid}-${opt.key}`);
    el.classList.add('disabled');
    if (opt.key === q.ans) {
      el.classList.add('correct');
    } else if (opt.key === pickedKey && !isRight) {
      el.classList.add('wrong');
    }
  });

  const expBox = document.getElementById(`exp-${qid}`);
  expBox.className = `exp-section show ${isRight ? 'is-correct' : 'is-wrong'}`;
  
  const headerHtml = isRight 
    ? `<div class="exp-header badge-correct">⭕ 正解！（正解：${q.ans}）</div>` 
    : `<div class="exp-header badge-wrong">❌ 不正解…（正解：${q.ans} / あなたの回答：${pickedKey}）</div>`;

  expBox.innerHTML = headerHtml + `<div>${q.exp}</div>`;
}

function resetExam() {
  answeredSet.clear();
  rightCount = 0;
  document.getElementById('done-count').innerText = 0;
  document.getElementById('right-count').innerText = 0;
  renderQuiz();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

window.onload = renderQuiz;
